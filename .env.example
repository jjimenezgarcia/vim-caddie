# Copy to .env and uncomment/edit as needed. Nothing here is required —
# docker-compose.yml's own defaults work out of the box on a typical
# Docker Engine install where /var/lib is writable by the daemon.

# Override where session data (one dir per active exercise, bind-mounted
# into that exercise's sandbox container) lives on the HOST. Needed if:
#   - the default (/var/lib/vim-caddie/sessions) isn't writable/shareable
#     on your setup (Docker Desktop's host-path allowlist, some snap
#     Docker installs, etc.)
#   - you want it somewhere else entirely
# Must be an ABSOLUTE path, and kept short: it becomes part of a real
# filesystem path a UNIX domain socket binds to, which the kernel caps at
# ~108 bytes total (see docker-compose.yml's comment on this mount).
# VIM_CADDIE_SESSIONS_DIR=/home/you/.cache/vim-caddie/sessions

# Only needed if frontend and backend must be served from different
# origins — same-origin (nginx proxying to backend) is the default and
# works for any normal deployment. Baked into the frontend at build time,
# so changing these requires a rebuild (docker compose build frontend).
# VITE_VIM_CADDIE_WS_URL=ws://your-server-address:8765
# VITE_VIM_CADDIE_HTTP_URL=http://your-server-address:8765
